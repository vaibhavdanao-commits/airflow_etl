# Copy this file to .env and adjust only if your warehouse is in a different location.
PROJECT_ROOT=D:/airflow_etl
CATALOG_DB=D:/airflow_etl/Warehouse/dimensional_model_catalog.db
WAREHOUSE_PATH=D:/airflow_etl/Warehouse/dimensional_model
NAMESPACE=star_schema

# Local Ollama OpenAI-compatible endpoint
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
LLM_TIMEOUT_SECONDS=90
MAX_RESULT_ROWS=500
